# Normalise every text file to LF in the repository and in checkouts, so tests
# that compare bytes behave the same on Windows and POSIX.
* text=auto eol=lf

# cmd.exe needs CRLF to parse batch files reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
