    // The whole item at once: fields left out get their defaults.
    replace(id, input) {
      if (!items.has(id)) return null;
      const title = validateTitle(input?.title);
      if (input?.done !== undefined && typeof input.done !== 'boolean') throw new ValidationError('done must be true or false');
      const todo = { id, title, done: input?.done ?? false };
      items.set(id, todo);
      return copy(todo);
    },

