const MAX_NOTE = 500;

function validateNote(note) {
  if (typeof note !== 'string') throw new ValidationError('note must be a string');
  if ([...note].length > MAX_NOTE) throw new ValidationError(`note must be at most ${MAX_NOTE} characters`);
  return note;
}

const copy = (todo) => ({ ...todo });
