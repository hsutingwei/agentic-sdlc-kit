    remove(id) {
      return items.delete(id);
    },

    // Removes every finished item and says how many.
    removeDone() {
      let removed = 0;
      for (const [id, todo] of items) {
        if (todo.done) {
          items.delete(id);
          removed++;
        }
      }
      return removed;
    },
